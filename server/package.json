{
  "name": "server",
  "version": "1.0.0",
  "description": "Ubigu Kartalla API Server",
  "main": "src/app.js",
  "scripts": {
    "setup": "npm ci && npm exec allow-scripts run",
    "dev": "concurrently npm:dev:* --color",
    "dev:server": "nodemon src/app",
    "dev:test": "vitest",
    "start": "node -r ts-node/register -r tsconfig-paths/register dist/app",
    "migrate": "node-pg-migrate -f ./migration.config.js --template-file-name ./migrations/.template.ts",
    "test": "vitest run",
    "lint": "eslint . ",
    "postbuild": "cp -r src/openapi dist/openapi",
    "build": "tsc"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": "prettier --write --ignore-unknown"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ubigu/kartalla.git"
  },
  "keywords": [
    "Ubigu",
    "kartalla",
    "REST",
    "API",
    "server"
  ],
  "author": "Ubigu Oy",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ubigu/kartalla/issues"
  },
  "homepage": "https://github.com/ubigu/kartalla#readme",
  "engines": {
    "node": "^22.21.0"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@types/async-retry": "^1.4.9",
    "@types/clamscan": "^2.4.1",
    "@types/multer": "^1.4.13",
    "async-retry": "^1.3.3",
    "clamscan": "^2.4.0",
    "compression": "^1.8.1",
    "connect-pg-simple": "^6.2.1",
    "email-templates": "^13.0.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-async-handler": "^1.2.0",
    "express-session": "^1.19.0",
    "express-validator": "^6.15.0",
    "file-type": "^21.3.4",
    "helmet": "^8.3.0",
    "js-yaml": "^4.3.0",
    "markdown-it": "^14.3.0",
    "moment": "^2.30.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^9.0.3",
    "ogr2ogr": "^3.1.1",
    "openid-client": "^6.8.4",
    "parse-css-color": "^0.2.1",
    "passport": "^0.7.0",
    "passport-azure-ad": "^4.3.5",
    "passport-google-oauth20": "^2.0.0",
    "pdfmake": "^0.3.11",
    "pg": "^8.22.0",
    "pg-promise": "^12.7.0",
    "proj4": "^2.20.9",
    "pug": "^3.0.4",
    "puppeteer": "^24.43.1",
    "puppeteer-cluster": "^0.25.0",
    "sharp": "^0.35.3",
    "staticmaps": "^1.13.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "winston": "^3.19.0"
  },
  "overrides": {
    "staticmaps": {
      "sharp": "^0.35.3"
    },
    "mailparser": "3.9.14"
  },
  "devDependencies": {
    "@lavamoat/allow-scripts": "^5.1.0",
    "@lavamoat/preinstall-always-fail": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^4.2.4",
    "@types/email-templates": "^8.0.4",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/geojson": "^7946.0.16",
    "@types/markdown-it": "^12.2.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.5",
    "@types/nodemailer": "^6.4.24",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pdfmake": "^0.3.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "concurrently": "^6.5.1",
    "dotenv": "^10.0.0",
    "eslint": "^9.39.5",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail#3.0.0": false,
      "passport-azure-ad>bunyan>dtrace-provider#0.8.8": false,
      "puppeteer#24.43.1": false,
      "staticmaps>modern-async>core-js-pure#3.49.0": false
    }
  }
}
